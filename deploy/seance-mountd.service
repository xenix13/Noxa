[Unit]
Description=Noxa - montage des partages réseau (SMB/CIFS)
After=network-online.target
Wants=network-online.target
Before=seance.service

[Service]
Type=simple
# Must run as root, WITHOUT mount isolation (PrivateTmp, ProtectSystem…):
# otherwise the shares would be mounted in a namespace invisible to Noxa.
ExecStart=/usr/bin/python3 -m noxa.mountd
WorkingDirectory=/opt/seance
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=seance-mountd
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
